diff --git a/.github/workflows/avx1-build.yml b/.github/workflows/avx1-build.yml
new file mode 100644
index 0000000000000000000000000000000000000000..819201c3a9f8a1e6671c73bf17d3d4c0aac0dd83
--- /dev/null
+++ b/.github/workflows/avx1-build.yml
@@ -0,0 +1,94 @@
+name: AVX1 verified candidates
+on:
+  workflow_dispatch:
+    inputs:
+      day:
+        description: Build date YYYYMMDD
+        required: true
+        type: string
+permissions:
+  contents: read
+concurrency:
+  group: avx1-candidates
+  cancel-in-progress: false
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 180
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.15'
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
+        with:
+          node-version: '22'
+      - name: Reclaim unused hosted toolchains for native builds
+        # The avatar viewport is an offline, reproducibly bundled graphics asset.
+        run: |
+          test "$RUNNER_OS" = Linux
+          sudo rm -rf -- /usr/share/dotnet /opt/ghc /usr/local/.ghcup
+      - name: Verify offline avatar renderer and dependency advisories
+        working-directory: tool/voice_avatar
+        run: |
+          npm ci --ignore-scripts --no-fund --no-audit
+          npm audit --omit=dev --audit-level=high
+          npm run build
+          npm test
+          git diff --exit-code -- ../../assets/voice_avatar
+      - name: Install native build tools
+        run: python -m pip install 'cmake>=3.31,<4' ninja
+      - name: Identify native source and toolchain cache
+        id: native-pins
+        run: python .avx1/native_cache_key.py
+      - uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830
+        id: native-cache
+        with:
+          path: |
+            .avx1-work/native/onnxruntime
+            .avx1-work/native/eigen
+            .avx1-work/native/ort-build
+          key: ${{ steps.native-pins.outputs.prefix }}-${{ hashFiles('.avx1/native-arm64.json', '.avx1/native_arm64.py') }}
+          restore-keys: ${{ steps.native-pins.outputs.prefix }}-
+      - name: Install pinned current Android SDK
+        run: python .avx1/android_sdk.py
+      - name: Build, test, audit and package
+        env:
+          BUILD_CHANNEL: latest
+          BUILD_DAY: ${{ inputs.day }}
+          CONDUIT_KEYSTORE_BASE64: ${{ secrets.CONDUIT_KEYSTORE_BASE64 }}
+          CONDUIT_KEYSTORE_PASSWORD: ${{ secrets.CONDUIT_KEYSTORE_PASSWORD }}
+        run: python .avx1/build.py
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: candidate-latest
+          path: .avx1-out/*
+          if-no-files-found: error
+          retention-days: 7
+          include-hidden-files: true
+      - name: Upload safe diagnostics
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: diagnostics-latest
+          path: |
+            .avx1-work/pip-audit.json
+            .avx1-work/security-gate.json
+            .avx1-work/native/build-receipt.json
+            .avx1-work/native/ort-build/Release/CMakeCache.txt
+            .avx1-work/native/ort-build/Release/compile_commands.json
+          if-no-files-found: ignore
+          include-hidden-files: true
+          retention-days: 3
+      - name: Preserve native compiler progress for retries
+        if: always() && steps.native-cache.outputs.cache-hit != 'true' && steps.native-cache.outputs.cache-primary-key != ''
+        uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830
+        with:
+          path: |
+            .avx1-work/native/onnxruntime
+            .avx1-work/native/eigen
+            .avx1-work/native/ort-build
+          key: ${{ steps.native-cache.outputs.cache-primary-key }}
