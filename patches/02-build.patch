diff --git a/.avx1/native_cache_proof.py b/.avx1/native_cache_proof.py
new file mode 100644
index 0000000000000000000000000000000000000000..6969f44dd74c1223ca29745130b731c885a0e7dd
--- /dev/null
+++ b/.avx1/native_cache_proof.py
@@ -0,0 +1,63 @@
+"""Reuse only exact ONNX outputs with immutable per-binary compiler evidence."""
+import ast
+import hashlib
+import json
+from pathlib import Path
+
+
+def file_hash(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def compilation_signature(path):
+    tree = ast.parse(Path(path).read_text('utf-8'))
+    functions = {n.name:n for n in tree.body if isinstance(n, ast.FunctionDef)}
+    calls = [n for n in ast.walk(functions['onnx_native']) if isinstance(n, ast.Call)
+             and isinstance(n.func, ast.Name) and n.func.id == 'run' and n.args
+             and isinstance(n.args[0], ast.Constant) and n.args[0].value == 'python']
+    if len(calls) != 1:
+        raise ValueError('ONNX compilation entry point changed')
+    # ast.dump changes its empty-field formatting between Python3.12/3.13.
+    # Encode semantic fields ourselves so maintenance/CI fingerprints agree.
+    def canonical(node):
+        if isinstance(node, ast.AST):
+            return {'type':type(node).__name__, 'fields':{
+                key:canonical(value) for key,value in ast.iter_fields(node)
+                if value is not None and value != []}}
+        if isinstance(node, list): return [canonical(value) for value in node]
+        return node
+    parts = [canonical(calls[0])]
+    for name in ('toolchain', 'onnx_compile_evidence', 'verify_elf', 'symbols', 'build_id'):
+        parts.append(canonical(functions[name]))
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id in ('FLAGS','LINK') for t in node.targets):
+            parts.append(canonical(node))
+    return hashlib.sha256(json.dumps(parts,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+
+
+def verify_cache(root, build, compiler):
+    root, build = Path(root), Path(build)
+    reference = root / '.avx1/measurements/onnx-qualified-reference.json'
+    try:
+        proof = json.loads(reference.read_text('utf-8'))
+        exact = (proof['policy_sha256'] == file_hash(root/'.avx1/native-arm64.json') and
+                 proof['toolchains_sha256'] == file_hash(root/'.avx1/toolchains.json') and
+                 proof['lockfile_sha256'] == file_hash(root/'pubspec.lock') and
+                 proof['compilation_signature'] == compilation_signature(root/'.avx1/native_arm64.py') and
+                 proof['compiler'] == compiler and
+                 proof['compile_database_sha256'] == file_hash(build/'Release/compile_commands.json'))
+        if not exact:
+            return {'status':'miss','reason':'native inputs/compiler/evidence changed'}
+        for name, expected in proof['binaries'].items():
+            paths = sorted(build.rglob(name), key=lambda p:len(str(p)))
+            if not paths or paths[0].is_symlink() or file_hash(paths[0]) != expected:
+                return {'status':'miss','reason':'native output missing or checksum changed'}
+        if set(proof['binaries']) != {'libonnxruntime.so','libonnxruntime4j_jni.so'}:
+            return {'status':'miss','reason':'incomplete ONNX output set'}
+        return {'status':'reused','reference_run':proof['run_id'],
+                'reference_source':proof['source_commit'],
+                'reference_sha256':file_hash(reference),
+                'scope':'Exact source/toolchain/flags/recipe/compiler/commands and both binary SHA256; ABI/exports/ELF/package gates still run'}
+    except (OSError, KeyError, ValueError, TypeError, SyntaxError):
+        return {'status':'miss','reason':'qualified native evidence unavailable'}
diff --git a/.avx1/portable_build.py b/.avx1/portable_build.py
new file mode 100644
index 0000000000000000000000000000000000000000..2892e3648ceb500c63c258fd1c5fe22f4fb04a3d
--- /dev/null
+++ b/.avx1/portable_build.py
@@ -0,0 +1,41 @@
+"""Model-independent entry point for the repository's pinned build recipe."""
+import argparse
+import datetime as dt
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+ROOT=Path(__file__).resolve().parents[1]
+def run(*args,capture=False):
+    result=subprocess.run([str(a) for a in args],cwd=ROOT,check=True,text=True,
+        stdout=subprocess.PIPE if capture else None,encoding='utf-8')
+    return result.stdout.strip() if capture else None
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('command',choices=['status','build','local'],nargs='?',default='status')
+    args=parser.parse_args()
+    project=json.loads((ROOT/'.avx1/project.json').read_text('utf-8'))
+    git=shutil.which('git')
+    if not git:raise RuntimeError('Install Git and retry; no LLM is required')
+    source=run(git,'rev-parse','HEAD',capture=True)
+    dirty=bool(run(git,'status','--porcelain',capture=True))
+    if args.command=='status':
+        print(json.dumps({'project':project['id'],'source':source,'clean':not dirty,
+            'model_required':False,'recipe':'.avx1/build.py','pins':'.avx1/toolchains.json'}));return
+    if dirty:raise RuntimeError('Commit/review source changes before building')
+    day=dt.datetime.now(dt.timezone(dt.timedelta(hours=6))).strftime('%Y%m%d')
+    if args.command=='local':
+        os.environ.update(BUILD_CHANNEL='latest',BUILD_DAY=day)
+        run(sys.executable,ROOT/'.avx1/build.py');return
+    gh=shutil.which('gh')
+    if not gh:raise RuntimeError('Install GitHub CLI and run gh auth login once; do not put a token in this project')
+    remote=run(gh,'api','repos/'+project['repository']+'/git/ref/heads/avx1','--jq','.object.sha',capture=True)
+    if remote!=source:raise RuntimeError('Published avx1 differs from this source; review and push the exact commit first')
+    run(gh,'workflow','run','avx1-build.yml','--repo',project['repository'],'--ref','avx1','-f','day='+day)
+    print('Build dispatched for '+source+'. The workflow performs checks and produces one verified candidate.')
+
+if __name__=='__main__':main()
diff --git a/.avx1/probe_cline_native.dart b/.avx1/probe_cline_native.dart
new file mode 100644
index 0000000000000000000000000000000000000000..eef4186aecf536655e61696d8342fc9f8efb7313
--- /dev/null
+++ b/.avx1/probe_cline_native.dart
@@ -0,0 +1,33 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'package:conduit_core/features/cline/models/cline_remote_profile.dart';
+import 'package:conduit_core/features/cline/services/cline_native_client.dart';
+import 'package:conduit_core/features/cline/services/cline_ssh_tunnel.dart';
+
+/// Read-only probe: connects, lists sessions and hydrates history. Never sends an agent prompt.
+Future<void> main(List<String> args) async {
+  ClineSshTunnel? tunnel;ClineNativeClient? client;
+  try {
+    final data=jsonDecode(await File(args.first).readAsString()) as Map<String,dynamic>;
+    if(args.length>1){data['host']='127.0.0.1';data['sshPort']=int.parse(args[1]);}
+    final profile=ClineRemoteProfile.decode(jsonEncode(data));
+    tunnel=await ClineSshTunnel.connect(profile,localPort:0);
+    client=await ClineNativeClient.connect(tunnel);
+    final context=await client.request('get_process_context');
+    final records=await client.request('list_cli_sessions');
+    if(context is! Map || records is! List)throw const ClineNativeException('contract');
+    var hydrated=0;
+    if(client.state.sessions.isNotEmpty){
+      final first=client.state.sessions.first.id;
+      final complete=client.changes.firstWhere((s)=>s.sessionId==first&&!s.loadingHistory);
+      client.openSession(first);final state=await complete.timeout(const Duration(seconds:20));
+      hydrated=state.messages.length;
+    }
+    stdout.writeln(jsonEncode({'status':'passed','native_json_transport':true,'mandatory_ssh_pin':true,
+      'session_count':records.length,'hydrated_message_count':hydrated,'agent_messages_sent':0,
+      'tool_approvals_sent':0,'webview_used':false}));
+  }catch(error){stdout.writeln(jsonEncode({'status':'failed','error_type':error.runtimeType.toString(),
+      'code':error is ClineNativeException?error.code:'connection','private_details_withheld':true}));exitCode=1;}
+  finally{await client?.close();await tunnel?.close();}
+}
