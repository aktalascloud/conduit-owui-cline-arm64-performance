+  test('inline image budget is shared; all PC file references remain in the prompt', () {
+    final image = 'data:image/png;base64,' + 'A' * (5 * 1024 * 1024);
+    final frame = clineSendFrame(
+      text: 'Inspect',
+      newSession: true,
+      project: '/synthetic',
+      provider: 'local',
+      model: 'm',
+      mode: 'act',
+      reasoning: 'none',
