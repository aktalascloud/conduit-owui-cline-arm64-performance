+  test('recoverable provider notices do not end the native turn or remove approvals', () {
+    client.sendMessage('Work');
+    wire.receive({'type': 'session_started', 'sessionId': 'own'});
+    wire.receive({
+      'type': 'approval_request',
+      'approvalId': 'a',
+      'sessionId': 'own',
+      'toolName': 'editor',
