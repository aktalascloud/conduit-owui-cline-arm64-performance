diff --git a/test/features/chat/voice_mode/voice_avatar_binding_test.dart b/test/features/chat/voice_mode/voice_avatar_binding_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..fb2b3da2d52583471b0aff7fa9be5a93bff83745
--- /dev/null
+++ b/test/features/chat/voice_mode/voice_avatar_binding_test.dart
@@ -0,0 +1,79 @@
+import 'dart:async';
+
+import 'package:conduit/features/chat/voice_mode/voice_avatar_binding.dart';
+import 'package:conduit_core/ports/app_lifecycle.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class _Lifecycle implements AppLifecyclePort {
+  final events = StreamController<AppLifecyclePhase>.broadcast(sync: true);
+  @override
+  AppLifecyclePhase? current = AppLifecyclePhase.resumed;
+  @override
+  Stream<AppLifecyclePhase> get changes => events.stream;
+  void set(AppLifecyclePhase value) {
+    current = value;
+    events.add(value);
+  }
+}
+
+void main() {
+  test(
+    'fresh model card replaces old avatar and respects explicit removal',
+    () async {
+      final lifecycle = _Lifecycle();
+      var id = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa';
+      var revision = 1;
+      final updates = <VoiceAvatarBinding?>[];
+      final subscription = watchVoiceAvatarBindings(
+        () async => {
+          'updated_at': revision,
+          'meta': {
+            'voice_avatar': id.isEmpty ? null : {'file_id': id},
+          },
+        },
+        lifecycle: lifecycle,
+        interval: const Duration(days: 1),
+      ).listen(updates.add);
+      await Future<void>.delayed(Duration.zero);
+      expect(updates.last?.fileId, id);
+      id = 'bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb';
+      revision++;
+      lifecycle.set(AppLifecyclePhase.resumed);
+      await Future<void>.delayed(Duration.zero);
+      expect(updates.last?.fileId, id);
+      id = '';
+      revision++;
+      lifecycle.set(AppLifecyclePhase.resumed);
+      await Future<void>.delayed(Duration.zero);
+      expect(updates.last, isNull);
+      await subscription.cancel();
+      await lifecycle.events.close();
+    },
+  );
+
+  test(
+    'background pauses metadata checks and cancellation stops polling',
+    () async {
+      final lifecycle = _Lifecycle()..set(AppLifecyclePhase.paused);
+      var calls = 0;
+      final subscription = watchVoiceAvatarBindings(
+        () async {
+          calls++;
+          return {};
+        },
+        lifecycle: lifecycle,
+        interval: const Duration(milliseconds: 5),
+      ).listen((_) {});
+      await Future<void>.delayed(const Duration(milliseconds: 15));
+      expect(calls, 0);
+      lifecycle.set(AppLifecyclePhase.resumed);
+      await Future<void>.delayed(Duration.zero);
+      expect(calls, 1);
+      await subscription.cancel();
+      final stoppedAt = calls;
+      await Future<void>.delayed(const Duration(milliseconds: 15));
+      expect(calls, stoppedAt);
+      await lifecycle.events.close();
+    },
+  );
+}
diff --git a/test/features/chat/voice_mode/voice_avatar_cache_test.dart b/test/features/chat/voice_mode/voice_avatar_cache_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..67fedf8061f2bf1b3120db33a26b8c43ab07f219
--- /dev/null
+++ b/test/features/chat/voice_mode/voice_avatar_cache_test.dart
@@ -0,0 +1,116 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:crypto/crypto.dart';
+
+import 'package:conduit/features/chat/voice_mode/voice_avatar_cache.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  late Directory directory;
+  late VoiceAvatarCache cache;
+  late String data;
+  setUp(() async {
+    directory = await Directory.systemTemp.createTemp('voice-avatar-cache-');
+    cache = VoiceAvatarCache(directory: () async => directory);
+    final bytes = Uint8List(20)..setAll(0, [0x67, 0x6c, 0x54, 0x46]);
+    ByteData.sublistView(bytes).setUint32(8, bytes.length, Endian.little);
+    data = base64Encode(bytes);
+  });
+  tearDown(() => directory.delete(recursive: true));
+
+  test(
+    'same avatar survives cache recreation; server/account/file isolate it',
+    () async {
+      var downloads = 0;
+      Future<String> download() async {
+        downloads++;
+        return data;
+      }
+
+      Future<String> load(
+        VoiceAvatarCache c,
+        String server,
+        String user,
+        String file,
+      ) => c.load(
+        server: server,
+        userId: user,
+        fileId: file,
+        download: download,
+      );
+      expect(await load(cache, 'a', 'u', 'one'), data);
+      cache = VoiceAvatarCache(directory: () async => directory);
+      expect(await load(cache, 'a', 'u', 'one'), data);
+      expect(downloads, 1);
+      await load(cache, 'b', 'u', 'one');
+      await load(cache, 'a', 'other', 'one');
+      await load(cache, 'a', 'u', 'two');
+      expect(downloads, 4);
+      final files = await directory
+          .list(recursive: true)
+          .where((f) => f is File)
+          .toList();
+      expect(files.length, 4);
+    },
+  );
+  test(
+    'changed server hash redownloads the same file ID exactly once',
+    () async {
+      var downloads = 0;
+      var body = data;
+      Future<String> load() => cache.load(
+        server: 'a',
+        userId: 'u',
+        fileId: 'same',
+        expectedSha256: sha256.convert(base64Decode(body)).toString(),
+        download: () async {
+          downloads++;
+          return body;
+        },
+      );
+      await load();
+      final changed = base64Decode(data);
+      changed[changed.length - 1] ^= 1;
+      body = base64Encode(changed);
+      expect(await load(), body);
+      await load();
+      expect(downloads, 2);
+    },
+  );
+
+  test(
+    'corrupt body is fetched again; invalid download is not stored',
+    () async {
+      var downloads = 0;
+      Future<String> load() => cache.load(
+        server: 'a',
+        userId: 'u',
+        fileId: 'one',
+        download: () async {
+          downloads++;
+          return data;
+        },
+      );
+      await load();
+      final file =
+          (await directory.list(recursive: true).where((f) => f is File).first)
+              as File;
+      final bytes = await file.readAsBytes();
+      bytes[bytes.length - 1] ^= 1;
+      await file.writeAsBytes(bytes);
+      expect(await load(), data);
+      expect(downloads, 2);
+      await expectLater(
+        cache.load(
+          server: 'a',
+          userId: 'u',
+          fileId: 'bad',
+          download: () async => base64Encode([1, 2, 3]),
+        ),
+        throwsFormatException,
+      );
+    },
+  );
+}
