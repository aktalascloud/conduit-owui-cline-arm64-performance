+    final name = clineString(
+      media['name'] ?? media['filename'],
+      l.clineAttachment,
+    );
+    return ActionChip(
+      avatar: const Icon(Icons.description_outlined, size: 18),
+      label: Text(name),
+      onPressed: () => Clipboard.setData(
+        ClipboardData(text: clineString(media['path'] ?? media['url'])),
+      ),
+    );
+  }
