+import '../../navigation/widgets/sidebar_page_leading_button.dart';
+import '../../../shared/theme/theme_extensions.dart';
+import '../../../shared/theme/color_tokens.dart' show withMinContrast;
+
+import 'package:conduit_core/providers/app_providers.dart'
+    show openWebUiAccountAvailableProvider;
+import 'package:conduit_core/features/navigation/models/sidebar_navigation_model.dart';
+import 'package:conduit_core/features/navigation/providers/sidebar_active_tab_provider.dart';
+
+import '../../../shared/widgets/markdown/streaming_markdown_widget.dart';
+import '../../../shared/widgets/horizontal_overflow_fade.dart';
+import 'cline_remote_page.dart';
+
+/// Avoid building an unused agent workspace at OWUI startup; once opened,
+/// retain it so switching tabs preserves its draft and SSH subscriptions.
+class ClineSidebarTab extends StatefulWidget {
+  const ClineSidebarTab({super.key, required this.active});
+  final bool active;
+  @override
+  State<ClineSidebarTab> createState() => _ClineSidebarTabState();
+}
+
+class _ClineSidebarTabState extends State<ClineSidebarTab> {
+  bool _visited = false;
+  @override
+  Widget build(BuildContext context) {
+    if (widget.active) _visited = true;
+    return _visited
+        ? ClineWorkspacePage(embedded: true, active: widget.active)
+        : const SizedBox.shrink();
+  }
+}
+
+/// Native Conduit chat, sessions and projects over the typed Cline transport.
+class ClineWorkspacePage extends ConsumerStatefulWidget {
+  const ClineWorkspacePage({
+    super.key,
+    this.embedded = false,
+    this.active = true,
+  });
+  final bool embedded;
+  final bool active;
+  @override
+  ConsumerState<ClineWorkspacePage> createState() => _ClineWorkspacePageState();
+}
+
+/// Ephemeral UI memory, scoped to this app/provider container; never sent to OWUI.
+class ClineWorkspaceMemory {
+  final drafts = <String, String>{};
+  final files = <String, List<ClineAttachment>>{};
+  final offsets = <String, double>{};
+}
+
+final clineWorkspaceMemoryProvider = Provider((ref) => ClineWorkspaceMemory());
+
+class _ClineWorkspacePageState extends ConsumerState<ClineWorkspacePage> {
+  final _storage = const FlutterSecureStorage();
+  final _input = TextEditingController();
+  final _scroll = ScrollController();
+  final _scaffold = GlobalKey<ScaffoldState>();
+  late final ClineWorkspaceMemory _memory;
+  late final Map<String, String> _drafts;
+  late final Map<String, List<ClineAttachment>> _files;
+  String _draftKey = '';
+  String? _connectError;
+  bool _connecting = false, _uploading = false;
+  int _generation = 0;
+  String? _lastScope;
+  bool _followOutput = true;
+  int? _lastRender;
+  Timer? _retryTimer;
+  int _retryAttempt = 0;
+  bool _manualDisconnect = false;
+  String? _restoreSession, _restoreUncertain, _restoreIdentity;
+  ClineDraftSelection? _restoreDraftSelection;
+
+  @override
+  void initState() {
+    super.initState();
+    _memory = ref.read(clineWorkspaceMemoryProvider);
+    _drafts = _memory.drafts;
+    _files = _memory.files;
+    ref.listenManual(clineBackendStateProvider, (previous, next) {
+      final state = next.value;
+      if (state == null) return;
+      if (!state.connected || (!state.hubConnected && !_connecting)) {
+        _scheduleReconnect();
+      } else if (state.hubConnected) {
+        _retryTimer?.cancel();
+        _retryTimer = null;
+        _retryAttempt = 0;
+        if (!state.busy && !state.loadingHistory && state.mode != 'act') {
+          try {
+            ref.read(clineBackendClientProvider)?.configure(mode: 'act');
+          } on ClineNativeException {
+            /* A simultaneous history update will notify again. */
+          }
+        }
+      }
+    });
+    _scroll.addListener(() {
+      if (_scroll.hasClients && _draftKey.isNotEmpty) {
+        _memory.offsets[_draftKey] = _scroll.offset;
+      }
+    });
+    if (widget.active) unawaited(_ensureConnected());
+  }
+
+  @override
+  void didUpdateWidget(ClineWorkspacePage oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (widget.active && !oldWidget.active && !_connecting) {
+      if (ref.read(clineBackendClientProvider)?.state.connected == false) {
+        _scheduleReconnect();
+      } else {
+        unawaited(_ensureConnected());
+      }
+    } else if (!widget.active) {
+      _retryTimer?.cancel();
+      _retryTimer = null;
+    }
+  }
+
+  void _settings() => context.push(
+    widget.embedded ? '${Routes.clineRemote}?embedded=1' : Routes.clineRemote,
+  );
+
