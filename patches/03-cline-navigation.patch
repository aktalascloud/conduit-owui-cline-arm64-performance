+  @override
+  void dispose() {
+    _retryTimer?.cancel();
+    _generation++;
+    if (_draftKey.isNotEmpty) _drafts[_draftKey] = _input.text;
+    _input.dispose();
+    _scroll.dispose();
+    super.dispose();
