diff --git a/packages/conduit_core/lib/utils/openwebui_message_payload.dart b/packages/conduit_core/lib/utils/openwebui_message_payload.dart
index c16ad3910f115b6917a869c5da6c5d2384a3d9dd..7e190c00dd18d68584a3ef04501911e200601781 100644
