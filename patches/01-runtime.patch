+  final ChatVoiceModeSnapshot snapshot;
+  final bool fillAvailable;
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    // Native microphone/audio setup completes before the optional graphics
+    // platform view is mounted. The renderer never owns the voice session.
+    if (!snapshot.isActive || snapshot.phase == ChatVoiceModePhase.starting) {
+      return const SizedBox.shrink();
+    }
+    final binding = ref.watch(voiceAvatarBindingProvider).asData?.value;
+    if (binding == null) return const SizedBox.shrink();
+    final id = binding.fileId;
+    final api = ref.watch(apiServiceProvider);
+    if (api == null) return const SizedBox.shrink();
+    final userId = ref.watch(currentUserProvider2)?.id;
+    if (userId == null) return const SizedBox.shrink();
+    return _AvatarViewport(
+      key: ValueKey((api, userId, id, binding.revision)),
+      api: api,
+      userId: userId,
+      fileId: id,
+      snapshot: snapshot,
+      fillAvailable: fillAvailable,
+      outputMetered: ref
+          .read(chatVoiceModeControllerProvider.notifier)
+          .hasAssistantOutputMeter,
+    );
+  }
+}
+
+class _AvatarViewport extends StatefulWidget {
+  const _AvatarViewport({
+    super.key,
+    required this.api,
+    required this.userId,
+    required this.fileId,
+    required this.snapshot,
+    required this.fillAvailable,
+    required this.outputMetered,
+  });
+  final ApiService api;
+  final String userId;
+  final String fileId;
+  final ChatVoiceModeSnapshot snapshot;
+  final bool fillAvailable;
+  final bool outputMetered;
+
+  @override
+  State<_AvatarViewport> createState() => _AvatarViewportState();
+}
+
+class _AvatarViewportState extends State<_AvatarViewport>
+    with WidgetsBindingObserver {
+  final _cancel = CancelToken();
+  late final Future<String> _html;
+  InAppWebViewController? _controller;
+  bool _loaded = false, _failed = false, _initializing = false;
+  bool _foreground = true;
+  String _failureCode = 'DOC';
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    _html = rootBundle.loadString('assets/voice_avatar/viewer.html');
+  }
+
+  @override
+  void didUpdateWidget(covariant _AvatarViewport oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    unawaited(_sync());
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    _foreground = state == AppLifecycleState.resumed;
+    unawaited(_sync());
+  }
+
+  Future<void> _sync() async {
+    if (!_loaded || !mounted) return;
+    final s = widget.snapshot;
+    final signals = voiceAvatarSignals(
+      speaking: s.phase == ChatVoiceModePhase.speaking,
+      intensity: s.intensity,
+      active: _foreground && s.isActive && !s.isCollapsed,
+      reducedMotion: MediaQuery.disableAnimationsOf(context),
+      outputMetered: widget.outputMetered,
+    );
+    try {
+      await _controller?.evaluateJavascript(
+        source: 'window.conduitAvatar?.signal(${jsonEncode(signals)});',
+      );
+    } catch (_) {
+      /* A disposed platform view has no live graphics state. */
+    }
+  }
+
+  Future<void> _load(InAppWebViewController controller) async {
+    if (_initializing || _loaded || !mounted) return;
+    _initializing = true;
+    try {
+      _failureCode = 'BOOT';
+      // Android onLoadStop can precede the renderer's script initialization.
+      var ready = false;
+      for (var attempt = 0; attempt < 100 && mounted; attempt++) {
+        final value = await controller.evaluateJavascript(
+          source: 'typeof window.conduitAvatar?.append === "function"',
+        );
+        if (value == true || value == 'true') {
+          ready = true;
+          break;
+        }
+        await Future<void>.delayed(const Duration(milliseconds: 100));
+      }
+      if (!ready || !mounted)
+        throw const FormatException('Avatar document unavailable');
+      _failureCode = 'FETCH';
+      final auth = widget.api.captureAuthSnapshot();
+      // Recheck current access, but never redownload an unchanged VRM body.
+      final info = await widget.api.getFileInfo(
+        widget.fileId,
+        authSnapshot: auth,
+        cancelToken: _cancel,
+      );
+      final meta = info['meta'];
+      final hash = meta is Map ? meta['file_hash'] : info['hash'];
+      final expectedHash =
+          hash is String && RegExp(r'^[a-fA-F0-9]{64}$').hasMatch(hash)
+          ? hash.toLowerCase()
+          : null;
+      final data = await VoiceAvatarCache().load(
+        server: widget.api.baseUrl,
+        userId: widget.userId,
+        fileId: widget.fileId,
+        expectedSha256: expectedHash,
+        download: () => widget.api.getFileContent(
+          widget.fileId,
+          maxBytes: voiceAvatarMaxBytes,
+          authSnapshot: auth,
+          cancelToken: _cancel,
+        ),
+      );
+      if (!mounted) return;
+      // Never send the API client, token, cookies or resource URLs to JS.
+      if (data.length > ((voiceAvatarMaxBytes + 2) ~/ 3) * 4 ||
+          !RegExp(r'^[A-Za-z0-9+/]*={0,2}$').hasMatch(data)) {
+        throw const FormatException('Invalid avatar data');
+      }
+      _failureCode = 'TRANSFER';
+      for (var start = 0; start < data.length; start += 131072) {
+        if (!mounted || _cancel.isCancelled) return;
+        final end = (start + 131072).clamp(0, data.length);
+        await controller.evaluateJavascript(
+          source:
+              'window.conduitAvatar.append(${jsonEncode(data.substring(start, end))});',
+        );
+      }
+      _failureCode = 'RENDER';
+      // Android's asynchronous-result helper uses a Native Messaging bridge.
+      // Keep that bridge disabled and read a bounded graphics-only result.
+      await controller.evaluateJavascript(
+        source: 'window.avatarLoadResult=null; void window.conduitAvatar.load().then(r=>window.avatarLoadResult=r);',
+      );
+      dynamic value;
+      for (var attempt = 0; attempt < 600 && mounted; attempt++) {
+        value = await controller.evaluateJavascript(
+          source: 'window.avatarLoadResult',
+        );
+        if (value is String) {
+          value = jsonDecode(value);
+        }
+        if (value is Map) break;
+        await Future<void>.delayed(const Duration(milliseconds: 100));
+      }
+      if (!mounted) return;
+      if (value is! Map || value['ok'] != true) {
+        throw const FormatException('Avatar renderer unavailable');
+      }
+      setState(() {
+        _loaded = true;
+        _failed = false;
+      });
+      await _sync();
+    } catch (error) {
+      if (error is DioException && error.response?.statusCode != null)
+        _failureCode = 'FETCH-${error.response!.statusCode}';
+      if (mounted) setState(() => _failed = true);
+    } finally {
+      _initializing = false;
+    }
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _cancel.cancel('Avatar view closed');
+    unawaited(
+      _controller
+          ?.evaluateJavascript(source: 'window.conduitAvatar?.dispose();')
+          .then<void>((_) {}, onError: (Object _) {}),
+    );
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = AppLocalizations.of(context)!;
+    if (_failed) {
+      return Padding(
+        padding: const EdgeInsets.symmetric(vertical: 8),
+        child: Text(
+          '${l10n.voiceAvatarUnavailable} [$_failureCode]',
+          style: TextStyle(color: context.conduitTheme.textSecondary),
+        ),
+      );
+    }
+    // Keep native call controls visible with a keyboard or a short viewport.
+    final room =
+        MediaQuery.sizeOf(context).height -
+        MediaQuery.viewInsetsOf(context).bottom;
+    final height = (room * .27).clamp(96.0, 230.0);
+    return SizedBox(
+      key: const ValueKey('voice-avatar-viewport'),
+      height: widget.fillAvailable ? null : height,
+      width: double.infinity,
+      child: Semantics(
+        container: true,
+        explicitChildNodes: true,
+        label: l10n.voiceAvatar,
+        image: true,
+        child: FutureBuilder<String>(
+          future: _html,
+          builder: (context, html) {
+            if (html.hasError)
+              return Text('${l10n.voiceAvatarUnavailable} [ASSET]');
+            if (!html.hasData) return const SizedBox.shrink();
+            return VoiceAvatarInteraction(
+              enabled: _loaded,
+              onView: (command) {
+                unawaited(
+                  _controller
+                      ?.evaluateJavascript(
+                        source:
+                            'window.conduitAvatar?.view(${jsonEncode(command)});',
+                      )
+                      .then<void>((_) {}, onError: (Object _) {}),
+                );
+              },
+              child: IgnorePointer(
+                child: InAppWebView(
+                  initialUrlRequest: Platform.isAndroid
+                      ? URLRequest(url: WebUri(voiceAvatarDocumentUrl))
+                      : null,
+                  initialData: Platform.isAndroid
+                      ? null
+                      : InAppWebViewInitialData(
+                          data: html.data!,
+                          baseUrl: WebUri(voiceAvatarDocumentUrl),
+                        ),
+                  initialSettings: voiceAvatarWebViewSettings(),
+                  onWebViewCreated: (c) => _controller = c,
+                  onLoadStop: (c, _) {
+                    unawaited(_load(c));
+                  },
+                  shouldOverrideUrlLoading: (_, action) async {
+                    if (voiceAvatarDocumentAllowed(
+                      action.request.url?.uriValue,
+                      isMainFrame: action.isForMainFrame == true,
+                    )) {
+                      return NavigationActionPolicy.ALLOW;
+                    }
+                    return NavigationActionPolicy.CANCEL;
+                  },
+                  shouldInterceptRequest: (_, request) async {
+                    if (voiceAvatarDocumentAllowed(
+                      request.url.uriValue,
+                      isMainFrame: request.isForMainFrame == true,
+                    )) {
+                      return WebResourceResponse(
+                        statusCode: 200,
+                        reasonPhrase: 'OK',
+                        contentType: 'text/html',
+                        contentEncoding: 'utf-8',
+                        data: Uint8List.fromList(utf8.encode(html.data!)),
+                      );
+                    }
+                    return voiceAvatarResourceAllowed(request.url.uriValue)
+                        ? null
+                        : WebResourceResponse(
+                            statusCode: 403,
+                            reasonPhrase: 'Blocked',
+                            contentType: 'text/plain',
+                            data: Uint8List(0),
+                          );
+                  },
+                  onCreateWindow: (_, _) async => false,
+                  onPermissionRequest: (_, _) async =>
+                      PermissionResponse(action: PermissionResponseAction.DENY),
+                  onShowFileChooser: (_, _) async => ShowFileChooserResponse(
+                    handledByClient: true,
+                    filePaths: null,
+                  ),
+                  onReceivedError: (_, request, _) {
+                    // A blocked favicon/subresource must not hide a healthy rig
+                    // or interrupt the independent native microphone/TTS path.
+                    if (mounted &&
+                        voiceAvatarLoadErrorIsFatal(
+                          request.url.uriValue,
+                          isMainFrame: request.isForMainFrame == true,
+                        )) {
+                      setState(() => _failed = true);
+                    }
+                  },
+                ),
+              ),
+            );
+          },
+        ),
+      ),
+    );
+  }
+}
+
+InAppWebViewSettings voiceAvatarWebViewSettings() => InAppWebViewSettings(
+  javaScriptEnabled: true,
+  webViewAssetLoader: WebViewAssetLoader(
+    domain: 'appassets.androidplatform.net',
+    pathHandlers: [AssetsPathHandler(path: '/assets/')],
+  ),
+  transparentBackground: true,
+  javaScriptCanOpenWindowsAutomatically: false,
+  supportMultipleWindows: false,
+  useShouldOverrideUrlLoading: true,
+  useShouldInterceptRequest: true,
+  useOnShowFileChooser: true,
+  incognito: true,
+  cacheEnabled: false,
+  domStorageEnabled: false,
+  databaseEnabled: false,
+  sharedCookiesEnabled: false,
+  thirdPartyCookiesEnabled: false,
+  allowContentAccess: false,
+  allowFileAccess: false,
+  allowFileAccessFromFileURLs: false,
+  allowUniversalAccessFromFileURLs: false,
+  blockNetworkLoads: true,
+  geolocationEnabled: false,
+  mediaPlaybackRequiresUserGesture: true,
+  allowsInlineMediaPlayback: false,
+  allowsAirPlayForMediaPlayback: false,
+  allowsPictureInPictureMediaPlayback: false,
+  disableContextMenu: true,
+  allowsLinkPreview: false,
+  isInspectable: false,
+  javaScriptBridgeEnabled: false,
+);
