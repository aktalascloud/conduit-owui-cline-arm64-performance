@@ -0,0 +1,98 @@
+import 'dart:math' as math;
+
+import 'package:flutter/gestures.dart';
+import 'package:material_ui/material_ui.dart';
+
+import '../../../l10n/app_localizations.dart';
+import '../../../shared/theme/theme_extensions.dart';
+
+/// Camera gestures stay native; the isolated viewport receives numbers only.
+class VoiceAvatarInteraction extends StatefulWidget {
+  const VoiceAvatarInteraction({
+    super.key,
+    required this.child,
+    required this.enabled,
+    required this.onView,
+  });
+  final Widget child;
+  final bool enabled;
+  final ValueChanged<Map<String, Object>> onView;
+  @override
+  State<VoiceAvatarInteraction> createState() => _VoiceAvatarInteractionState();
+}
+
+class _VoiceAvatarInteractionState extends State<VoiceAvatarInteraction> {
+  var _scale = 1.0;
+  void _send(Map<String, Object> value) {
+    if (widget.enabled &&
+        value.values.every((v) => v is bool || (v is num && v.isFinite)))
+      widget.onView(value);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = AppLocalizations.of(context)!;
+    return Stack(
+      fit: StackFit.expand,
+      children: [
+        Listener(
+          onPointerSignal: (event) {
+            if (event is PointerScrollEvent && widget.enabled) {
+              GestureBinding.instance.pointerSignalResolver.register(
+                event,
+                (_) => _send({
+                  'scale': math.exp(
+                    event.scrollDelta.dy.clamp(-240, 240) * .001,
+                  ),
+                }),
+              );
+            }
+          },
+          child: GestureDetector(
+            behavior: HitTestBehavior.opaque,
+            onScaleStart: (_) => _scale = 1,
+            onScaleUpdate: (event) {
+              if (event.pointerCount > 1) {
+                if (event.scale > 0)
+                  _send({
+                    'scale': _scale / event.scale,
+                    'panX': event.focalPointDelta.dx / 2,
+                    'panY': event.focalPointDelta.dy / 2,
+                  });
+              } else {
+                _send({
+                  'dx': event.focalPointDelta.dx,
+                  'dy': event.focalPointDelta.dy,
+                });
+              }
+              _scale = event.scale;
+            },
+            onDoubleTap: () => _send({'reset': true}),
+            child: widget.child,
+          ),
+        ),
+        Positioned(
+          top: Spacing.sm,
+          right: Spacing.sm,
+          child: Material(
+            color: context.conduitTheme.cardBackground.withValues(alpha: .96),
+            borderRadius: BorderRadius.circular(AppBorderRadius.button),
+            child: Row(
+              mainAxisSize: MainAxisSize.min,
+              children: [
+                IconButton(
+                  key: const Key('avatar-reset-view'),
+                  tooltip: l.voiceAvatarResetView,
+                  onPressed: widget.enabled
+                      ? () => _send({'reset': true})
+                      : null,
+                  icon: const Icon(Icons.restart_alt),
+                ),
+              ],
+            ),
+          ),
+        ),
+      ],
+    );
+  }
+}
diff --git a/lib/features/chat/voice_mode/voice_avatar_policy.dart b/lib/features/chat/voice_mode/voice_avatar_policy.dart
new file mode 100644
index 0000000000000000000000000000000000000000..0ce1089729c93cf69a514ae02704a724db8d5293
--- /dev/null
+++ b/lib/features/chat/voice_mode/voice_avatar_policy.dart
@@ -0,0 +1,46 @@
+import 'package:conduit_core/models/model.dart';
+
+const voiceAvatarMaxBytes = 25 * 1024 * 1024;
+const voiceAvatarOrigin = 'https://appassets.androidplatform.net';
+const voiceAvatarDocumentUrl =
+    '$voiceAvatarOrigin/assets/flutter_assets/assets/voice_avatar/viewer.html';
+
+/// Only model-owned file IDs are accepted, never provider-supplied URLs.
+String? voiceAvatarFileId(Model? model) {
+  return voiceAvatarIdFromMetadata(model?.metadata);
+}
+
+String? voiceAvatarIdFromMetadata(Map? metadata) {
+  final info = metadata?['info'];
+  final meta = info is Map ? info['meta'] : metadata?['meta'];
+  final avatar = meta is Map ? meta['voice_avatar'] : null;
+  final id = avatar is Map ? avatar['file_id'] : null;
+  return id is String &&
+          RegExp(r'^[a-fA-F0-9]{8}-(?:[a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}$')
+              .hasMatch(id)
+      ? id
+      : null;
+}
+
+bool voiceAvatarResourceAllowed(Uri? uri) => uri?.scheme == 'blob';
+
+/// The one synthetic document is served from bundled bytes, never the network.
+bool voiceAvatarDocumentAllowed(Uri? uri, {required bool isMainFrame}) =>
+    isMainFrame && uri?.toString() == voiceAvatarDocumentUrl;
+
+bool voiceAvatarLoadErrorIsFatal(Uri? uri, {required bool isMainFrame}) =>
+    voiceAvatarDocumentAllowed(uri, isMainFrame: isMainFrame);
+
+Map<String, Object> voiceAvatarSignals({
+  required bool speaking,
+  required int intensity,
+  required bool active,
+  required bool reducedMotion,
+  bool outputMetered = true,
+}) => {
+  'speaking': speaking && active,
+  'level': speaking && active ? intensity.clamp(0, 10) / 10 : 0.0,
+  'active': active,
+  'reducedMotion': reducedMotion,
+  'metered': outputMetered,
+};
