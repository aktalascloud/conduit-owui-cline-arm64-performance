index 0000000000000000000000000000000000000000..27c94001a97822f311bfa11ccf71d04d33deaa82
--- /dev/null
+++ b/tool/voice_avatar/renderer.js
@@ -0,0 +1,165 @@
+import * as THREE from 'three';
+import {GLTFLoader} from 'three/addons/loaders/GLTFLoader.js';
+import {VRMLoaderPlugin, VRMUtils} from '@pixiv/three-vrm';
+import {boundedBitmapLoader} from './texture-loader.js';
+
+const MAX = 25 * 1024 * 1024;
+// Match phone density without exceeding a 2 MP drawing buffer or GPU limits.
+export function renderPixelRatio(dpr, width, height, maxDimension=4096) {
+  const w=Math.max(1,Number(width)||1),h=Math.max(1,Number(height)||1);
+  return Math.min(Math.max(1,Number(dpr)||1),3,Math.sqrt(2_000_000/(w*h)),maxDimension/w,maxDimension/h);
+}
+export function fullBodyDistance(width,height,depth,aspect,fov=30) {
+  const tangent=Math.tan(fov*Math.PI/360);
+  return Math.max(height/(2*tangent),width/(2*tangent*Math.max(.1,aspect)))*1.08+depth/2;
+}
+// Standard TTS exposes playback events, not PCM. Keep that approximation
+// explicit instead of animating from the user's microphone or claiming visemes.
+export function mouthWeight(time,{speaking=false,level=0,metered=true}={}) {
+  if(!speaking)return 0;
+  if(metered)return Math.min(1,Math.max(0,Number(level)||0));
+  return .12+.42*Math.abs(Math.sin(time*9.4))*Math.abs(Math.cos(time*2.1));
+}
+export function readAvatar(data) {
+  if (data.byteLength < 28 || data.byteLength > MAX) throw Error('Invalid avatar size');
+  const v = new DataView(data), n = v.getUint32(12, true);
+  if (v.getUint32(0,true)!==0x46546c67 || v.getUint32(4,true)!==2 ||
+      v.getUint32(8,true)!==data.byteLength || v.getUint32(16,true)!==0x4e4f534a ||
+      n>2*1024*1024 || n+28>data.byteLength ||
+      v.getUint32(n+24,true)!==0x004e4942 || n+28+v.getUint32(n+20,true)!==data.byteLength)
+    throw Error('Invalid avatar container');
+  const j=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(data,20,n)));
+  const vrm=j.extensions?.VRMC_vrm ?? j.extensions?.VRM;
+  const bones=Array.isArray(vrm?.humanoid?.humanBones)
+    ? Object.fromEntries(vrm.humanoid.humanBones.map(b=>[b.bone,b])) : vrm?.humanoid?.humanBones;
+  for(const name of ['hips','spine','head','leftUpperArm','rightUpperArm','leftLowerArm','rightLowerArm'])
+    if(!Number.isInteger(bones?.[name]?.node) || !j.nodes?.[bones[name].node]) throw Error('Invalid humanoid rig');
+  if(j.buffers?.length!==1 || j.buffers[0].uri || !Number.isInteger(j.buffers[0].byteLength) ||
+      j.buffers[0].byteLength<0 || j.buffers[0].byteLength>data.byteLength-n-28 ||
+      (j.nodes?.length??0)>512 || (j.images?.length??0)>32 ||
+      (j.accessors??[]).some(a=>!Number.isSafeInteger(a.count)||a.count<0) ||
+      (j.accessors??[]).reduce((a,b)=>a+b.count,0)>5_000_000)
+    throw Error('External or oversized avatar resources');
+  for(const image of j.images??[]) {
+    const b=j.bufferViews?.[image.bufferView];
+    if(image.uri || !Number.isInteger(image.bufferView) || !b || (b.buffer??0)!==0 ||
+        !Number.isInteger(b.byteLength) || b.byteLength<0 || !Number.isInteger(b.byteOffset??0) ||
+        (b.byteOffset??0)<0 || (b.byteOffset??0)+b.byteLength>j.buffers[0].byteLength ||
+        !['image/png','image/jpeg','image/webp'].includes(image.mimeType)) throw Error('Invalid avatar texture');
+  }
+  return {json:j,start:n+28};
+}
+
+export function updateAvatarView(view, command, height=1, distance=1) {
+  if(!command || typeof command!=='object')return;
+  if(command.reset===true){Object.assign(view,{yaw:0,pitch:0,zoom:1,panX:0,panY:0});return;}
+  const bounded=(value,min,max,fallback=0)=>Number.isFinite(value)?Math.max(min,Math.min(max,value)):fallback;
+  const radians=2*Math.PI/Math.max(1,height);
+  view.yaw=(view.yaw-bounded(command.dx,-2048,2048)*radians)%(2*Math.PI);
+  view.pitch=bounded(view.pitch+bounded(command.dy,-2048,2048)*radians,-1.3,1.3);
+  view.zoom=bounded(view.zoom*bounded(command.scale,.5,2,1),.3,3,1);
+  const pixel=2*distance*view.zoom*Math.tan(Math.PI/12)/Math.max(1,height);
+  view.panX=bounded(view.panX-bounded(command.panX,-2048,2048)*pixel,-2*distance,2*distance);
+  view.panY=bounded(view.panY+bounded(command.panY,-2048,2048)*pixel,-2*distance,2*distance);
+}
+
+export async function createAvatar(canvas,data) {
+  const {json:j,start}=readAvatar(data);
+  let pixels=0;const images=[];
+  for(const im of j.images??[]) {
+    const b=j.bufferViews[im.bufferView];
+    const bytes=new Uint8Array(data,start+(b.byteOffset??0),b.byteLength);
+    const bmp=await createImageBitmap(new Blob([bytes],{type:im.mimeType}));
+    images.push({data:bytes,width:bmp.width,height:bmp.height});
+    const invalid=bmp.width>8192 || bmp.height>8192 || (pixels+=bmp.width*bmp.height)>128*1024*1024;
+    bmp.close(); if(invalid) throw Error('Avatar texture budget exceeded');
+  }
+  const manager=new THREE.LoadingManager();
+  manager.setURLModifier(u=>{if(!u.startsWith('blob:'))throw Error('External resources blocked');return u;});
+  const loader=new GLTFLoader(manager); loader.register(p=>{
+    Object.assign(p,{textureLoader:boundedBitmapLoader(images)});
+    return new VRMLoaderPlugin(p);
+  });
+  const gltf=await loader.parseAsync(data,''); const vrm=gltf.userData.vrm;
+  if(!vrm){VRMUtils.deepDispose(gltf.scene);throw Error('Unsupported VRM');}
+  VRMUtils.rotateVRM0(vrm);
+  let renderer;
+  try{renderer=new THREE.WebGLRenderer({canvas,alpha:true,antialias:true,powerPreference:'low-power'});}
+  catch(e){VRMUtils.deepDispose(vrm.scene);throw e;}
+  const anisotropy=Math.max(1,Math.min(4,renderer.capabilities.getMaxAnisotropy()));
+  vrm.scene.traverse(object=>{
+    for(const material of (Array.isArray(object.material)?object.material:[object.material]))
+      if(material?.map)material.map.anisotropy=anisotropy;
+  });
+  renderer.setClearColor(0,0); renderer.outputColorSpace=THREE.SRGBColorSpace;
+  const scene=new THREE.Scene();scene.add(vrm.scene,new THREE.HemisphereLight(0xffffff,0x9ca3af,2));
+  const light=new THREE.DirectionalLight(0xffffff,2.2);light.position.set(-1,2,3);scene.add(light);
+  const bone=n=>vrm.humanoid.getNormalizedBoneNode(n);
+  const mirror=vrm.meta.metaVersion==='0'?-1:1;
+  if(bone('leftUpperArm'))bone('leftUpperArm').rotation.z=-1.35*mirror;
+  if(bone('rightUpperArm'))bone('rightUpperArm').rotation.z=1.35*mirror;
+  if(bone('hips'))bone('hips').rotation.z=.035*mirror;
+  if(bone('spine'))bone('spine').rotation.z=-.02*mirror;
+  if(bone('leftLowerArm'))bone('leftLowerArm').rotation.x=-.08;
+  if(bone('rightLowerArm'))bone('rightLowerArm').rotation.x=-.12;
+  vrm.update(0);vrm.scene.updateMatrixWorld(true);
+  const bounds=new THREE.Box3().setFromObject(vrm.scene,true);
+  const size=bounds.getSize(new THREE.Vector3()),center=bounds.getCenter(new THREE.Vector3());
+  if(![size.x,size.y,size.z,center.x,center.y,center.z].every(Number.isFinite)||size.y<=0) {
+    VRMUtils.deepDispose(vrm.scene);renderer.dispose();throw Error('Invalid avatar bounds');
+  }
+  const camera=new THREE.PerspectiveCamera(30,1,.01,50);
+  const expressions=vrm.expressionManager;
+  const view={yaw:0,pitch:0,zoom:1,panX:0,panY:0};
+  let elapsed=0,disposed=false,lastWidth=0,lastHeight=0,lastRatio=0;
+  return {
+    view(command){updateAvatarView(view,command,canvas.clientHeight,fullBodyDistance(size.x,size.y,size.z,camera.aspect,camera.fov));},
+    capabilities:{mouth:!!expressions?.getExpression('aa'),blink:!!expressions?.getExpression('blink')},
+    render(dt,{speaking=false,level=0,metered=true,reducedMotion=false}={}) {
+      if(disposed)return;
+      elapsed+=Math.min(.1,Math.max(0,dt));
+      const w=Math.max(1,canvas.clientWidth),h=Math.max(1,canvas.clientHeight);
+      const ratio=renderPixelRatio(window.devicePixelRatio,w,h,renderer.capabilities.maxTextureSize);
+      if(w!==lastWidth||h!==lastHeight||ratio!==lastRatio){
+        lastWidth=w;lastHeight=h;lastRatio=ratio;renderer.setPixelRatio(ratio);renderer.setSize(w,h,false);
+        camera.aspect=w/h;camera.updateProjectionMatrix();
+      }
+      const distance=fullBodyDistance(size.x,size.y,size.z,camera.aspect,camera.fov);
+      camera.far=Math.max(50,distance*view.zoom+size.z+size.y);camera.updateProjectionMatrix();
+      camera.position.setFromSphericalCoords(distance*view.zoom,Math.PI/2-view.pitch,view.yaw).add(center);
+      camera.lookAt(center);camera.translateX(view.panX);camera.translateY(view.panY);
+      expressions?.setValue('aa',mouthWeight(elapsed,{speaking,level,metered}));
+      const blink=reducedMotion?0:Math.max(0,1-Math.abs((elapsed%4.6)-4.45)/.09);
+      if(expressions?.getExpression('blink'))expressions.setValue('blink',blink);
+      else{expressions?.setValue('blinkLeft',blink);expressions?.setValue('blinkRight',blink);}
+      vrm.update(Math.min(.1,Math.max(0,dt)));renderer.render(scene,camera);
+    },
+    dispose(){disposed=true;VRMUtils.deepDispose(vrm.scene);renderer.dispose();renderer.forceContextLoss();}
+  };
+}
+
+if(typeof window!=='undefined' && document.getElementById('avatar')) {
+  let chunks=[],bytes=0,avatar=null,dead=false,frame=0,last=0;
+  let signals={speaking:false,level:0,reducedMotion:false,active:true};
+  const canvas=document.getElementById('avatar');
+  const stop=()=>{cancelAnimationFrame(frame);frame=0;last=0;};
+  const tick=t=>{
+    frame=0;if(dead||document.hidden||!signals.active)return;
+    if(t-last>=1000/30){avatar?.render(last?(t-last)/1000:0,signals);last=t;}
+    frame=requestAnimationFrame(tick);
+  };
+  const resume=()=>{if(avatar&&!dead&&!document.hidden&&signals.active&&!frame)frame=requestAnimationFrame(tick);};
+  document.addEventListener('visibilitychange',()=>{stop();resume();});
+  canvas.addEventListener('webglcontextlost',e=>{e.preventDefault();stop();dead=true;});
+  window.conduitAvatar={
+    append(part){if(dead||avatar||typeof part!=='string'||part.length>131072||(bytes+=part.length)>Math.ceil(MAX/3)*4)throw Error('Invalid transfer');chunks.push(part);},
+    async load(){try{const raw=atob(chunks.join(''));chunks=[];const data=Uint8Array.from(raw,c=>c.charCodeAt(0)).buffer;
+      const loaded=await createAvatar(canvas,data);if(dead){loaded.dispose();return false;}avatar=loaded;
+      // Report readiness only after the first real WebGL draw succeeds.
+      avatar.render(0,{speaking:false,reducedMotion:true});resume();return {ok:true,...avatar.capabilities};
+    }catch(_){chunks=[];return {ok:false};}},
+    view(command){if(!dead)avatar?.view(command);},
+    signal(value){signals={...signals,...value};stop();if(!signals.active)avatar?.render(0,{speaking:false,reducedMotion:true});else resume();},
+    dispose(){dead=true;chunks=[];stop();avatar?.dispose();avatar=null;}
+  };
+}
diff --git a/tool/voice_avatar/test.mjs b/tool/voice_avatar/test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a1cf3ddf37488275b8abeaab0f89e8540b73ccb6
--- /dev/null
+++ b/tool/voice_avatar/test.mjs
@@ -0,0 +1,87 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {readAvatar,mouthWeight,renderPixelRatio,fullBodyDistance,updateAvatarView} from './renderer.js';
+import {textureResizePlan,boundedBitmapLoader} from './texture-loader.js';
+
+test('full-body framing fits head, feet and width on tall and wide viewports',()=>{
+ for(const aspect of [.45,.7,1,2]) {
+  const distance=fullBodyDistance(.8,1.85,.4,aspect);
+  const visibleHalfHeight=(distance-.2)*Math.tan(Math.PI/12);
+  assert.ok(visibleHalfHeight>1.85/2);assert.ok(visibleHalfHeight*aspect>.8/2);
+ }
+});
+
+test('large source textures fit a bounded GPU budget without upscaling',async()=>{
+ const sizes=[{width:8192,height:8192},{width:4096,height:4096}];
+ const plans=textureResizePlan(sizes);
+ assert.ok(plans.reduce((n,p)=>n+p.width*p.height,0)<=32*1024*1024);
+ assert.ok(plans.every(p=>p.width<=4096&&p.height<=4096));
+ assert.deepEqual(textureResizePlan([{width:128,height:256}]),[{width:128,height:256}]);
+ await new Promise(resolve=>boundedBitmapLoader([]).load('https://example.invalid',()=>assert.fail('Remote image loaded'),null,error=>{assert.match(error.message,/blocked/);resolve();}));
+});
+
+test('phone density stays sharp within bounded GPU buffer dimensions',()=>{
+ assert.equal(renderPixelRatio(3,360,230),3);
+ assert.equal(renderPixelRatio(4,360,230),3);
+ assert.equal(renderPixelRatio(1,360,230),1);
+ assert.equal(renderPixelRatio(undefined,360,230),1);
+ for(const [w,h,max] of [[2000,1500,4096],[5000,100,2048],[360,230,1024]]) {
+  const r=renderPixelRatio(4,w,h,max);
+  assert.ok(w*h*r*r<=2_000_001);assert.ok(w*r<=max);assert.ok(h*r<=max);
+ }
+});
+
+test('standard TTS animates only during actual playback; metered silence stays closed',()=>{
+ assert.equal(mouthWeight(1,{speaking:false,metered:false}),0);
+ assert.equal(mouthWeight(1,{speaking:true,metered:true,level:0}),0);
+ assert.equal(mouthWeight(1,{speaking:true,metered:true,level:.6}),.6);
+ const a=mouthWeight(1,{speaking:true,metered:false,level:0});
+ const b=mouthWeight(1.1,{speaking:true,metered:false,level:0});
+ assert.ok(a>0&&b>0&&a!==b);
+ assert.equal(mouthWeight(1,{speaking:false,metered:true,level:10}),0);
+});
+
+function fixture(change=()=>{}) {
+ const bones=['hips','spine','head','leftUpperArm','rightUpperArm','leftLowerArm','rightLowerArm'];
+ const j={nodes:bones.map(name=>({name})),extensions:{VRM:{humanoid:{humanBones:bones.map((bone,node)=>({bone,node}))}}},buffers:[{byteLength:4}]};
+ change(j);
+ let text=JSON.stringify(j);text+=' '.repeat((4-text.length%4)%4);
+ const raw=Buffer.from(text),data=Buffer.alloc(raw.length+32);
