diff --git a/lib/features/chat/voice_mode/voice_avatar_binding.dart b/lib/features/chat/voice_mode/voice_avatar_binding.dart
new file mode 100644
index 0000000000000000000000000000000000000000..01b42de731d3941809de6c5a148eb8006bed4ac2
--- /dev/null
+++ b/lib/features/chat/voice_mode/voice_avatar_binding.dart
@@ -0,0 +1,77 @@
+import 'dart:async';
+
+import 'package:conduit_core/ports/app_lifecycle.dart';
+import 'package:conduit_core/providers/app_providers.dart';
+import 'package:conduit_core/providers/host_ports.dart';
+import 'package:conduit_core/features/auth/providers/unified_auth_providers.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'voice_avatar_policy.dart';
+
+typedef VoiceAvatarBinding = ({String fileId, String revision});
+
+/// Re-read the model card: the selected model object can outlive an avatar edit.
+final voiceAvatarBindingProvider =
+    StreamProvider.autoDispose<VoiceAvatarBinding?>((ref) {
+      final model = ref.watch(selectedModelProvider);
+      final api = ref.watch(apiServiceProvider);
+      if (model == null || api == null) return Stream.value(null);
+      if (ref.watch(currentUserProvider2)?.id == null)
+        return Stream.value(null);
+      return watchVoiceAvatarBindings(
+        () => api.getModelDetails(model.id),
+        lifecycle: ref.watch(appLifecycleProvider),
+      );
+    });
+
+Stream<VoiceAvatarBinding?> watchVoiceAvatarBindings(
+  Future<Map<String, dynamic>?> Function() fetch, {
+  required AppLifecyclePort lifecycle,
+  Duration interval = const Duration(seconds: 15),
+}) {
+  late StreamController<VoiceAvatarBinding?> controller;
+  Timer? timer;
+  StreamSubscription<AppLifecyclePhase>? subscription;
+  var closed = false, busy = false, first = true;
+  var foreground = !(lifecycle.current?.isBackground ?? false);
+  Future<void> refresh() async {
+    if (closed || busy || !foreground) return;
+    busy = true;
+    try {
+      final profile = await fetch();
+      if (closed) return;
+      if (profile != null) {
+        final id = voiceAvatarIdFromMetadata(profile);
+        controller.add(
+          id == null
+              ? null
+              : (fileId: id, revision: '${profile['updated_at'] ?? ''}'),
+        );
+      } else if (first) {
+        controller.add(null);
+      }
+      first = false;
+    } catch (_) {
+      if (!closed && first) controller.add(null);
+    } finally {
+      busy = false;
+    }
+  }
+
+  controller = StreamController<VoiceAvatarBinding?>(
+    onListen: () {
+      unawaited(refresh());
+      timer = Timer.periodic(interval, (_) => unawaited(refresh()));
+      subscription = lifecycle.changes.listen((phase) {
+        foreground = !phase.isBackground;
+        if (phase == AppLifecyclePhase.resumed) unawaited(refresh());
+      });
+    },
+    onCancel: () async {
+      closed = true;
+      timer?.cancel();
+      await subscription?.cancel();
+    },
+  );
+  return controller.stream;
+}
diff --git a/lib/features/chat/voice_mode/voice_avatar_cache.dart b/lib/features/chat/voice_mode/voice_avatar_cache.dart
new file mode 100644
index 0000000000000000000000000000000000000000..804324720146674d32e4e2eaf132938eea475c2d
--- /dev/null
+++ b/lib/features/chat/voice_mode/voice_avatar_cache.dart
@@ -0,0 +1,110 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:crypto/crypto.dart';
+import 'package:path_provider/path_provider.dart';
+
+import 'voice_avatar_policy.dart';
+
+/// Private, bounded cache: no tokens, URLs or model names in filenames.
+class VoiceAvatarCache {
+  VoiceAvatarCache({Future<Directory> Function()? directory})
+    : _directory = directory ?? getTemporaryDirectory;
+
+  final Future<Directory> Function() _directory;
+  static const maxCacheBytes = 100 * 1024 * 1024;
+
+  Future<String> load({
+    required String server,
+    required String userId,
+    required String fileId,
+    String? expectedSha256,
+    required Future<String> Function() download,
+  }) async {
+    final key = sha256.convert(
+      utf8.encode(jsonEncode([server, userId, fileId])),
+    );
+    Directory? root;
+    File? file;
+    try {
+      root = Directory('${(await _directory()).path}/voice-avatars-v1');
+      await root.create(recursive: true);
+      file = File('${root.path}/$key.vrmcache');
+      if (await file.exists()) {
+        if (await file.length() <= voiceAvatarMaxBytes + 65) {
+          final stored = await file.readAsBytes();
+          if (stored.length > 65) {
+            final bytes = Uint8List.sublistView(stored, 65);
+            if (utf8.decode(stored.sublist(0, 64)) ==
+                    sha256.convert(bytes).toString() &&
+                _valid(bytes) &&
+                (expectedSha256 == null ||
+                    sha256.convert(bytes).toString() == expectedSha256)) {
+              await file.setLastModified(DateTime.now());
+              return base64Encode(bytes);
+            }
+          }
+        }
+        await file.delete();
+      }
+    } catch (_) {
+      // A full/unavailable cache must not stop an authenticated avatar load.
+    }
+    final data = await download();
+    final bytes = base64Decode(data);
+    if (!_valid(bytes)) throw const FormatException('Invalid avatar data');
+    if (expectedSha256 != null &&
+        sha256.convert(bytes).toString() != expectedSha256) {
+      throw const FormatException('Avatar changed during download');
+    }
+    if (root != null && file != null) {
+      final temporary = File(
+        '${file.path}.${DateTime.now().microsecondsSinceEpoch}.tmp',
+      );
+      try {
+        await temporary.writeAsBytes([
+          ...utf8.encode('${sha256.convert(bytes)}\n'),
+          ...bytes,
+        ], flush: true);
+        await temporary.rename(file.path);
+        final entries = await root
+            .list(followLinks: false)
+            .where((entry) => entry is File && entry.path.endsWith('.vrmcache'))
+            .cast<File>()
+            .toList();
+        final stats = <File, FileStat>{};
+        for (final entry in entries) {
+          stats[entry] = await entry.stat();
+        }
+        entries.sort(
+          (a, b) => stats[a]!.modified.compareTo(stats[b]!.modified),
+        );
+        var total = stats.values.fold<int>(0, (sum, stat) => sum + stat.size);
+        for (final entry in entries) {
+          if (total <= maxCacheBytes) break;
+          total -= stats[entry]!.size;
+          await entry.delete();
+        }
+      } catch (_) {
+        // Rendering still works if cache storage runs out of space.
+      } finally {
+        try {
+          if (await temporary.exists()) await temporary.delete();
+        } catch (_) {
+          /* Cache cleanup cannot interrupt voice graphics. */
+        }
+      }
+    }
+    return data;
+  }
+
+  bool _valid(Uint8List bytes) =>
+      bytes.length >= 20 &&
+      bytes.length <= voiceAvatarMaxBytes &&
+      bytes[0] == 0x67 &&
+      bytes[1] == 0x6c &&
+      bytes[2] == 0x54 &&
+      bytes[3] == 0x46 &&
+      ByteData.sublistView(bytes).getUint32(8, Endian.little) == bytes.length;
+}
