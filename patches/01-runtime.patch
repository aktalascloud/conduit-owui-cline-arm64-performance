+  void _send(ClineNativeClient client, ClineNativeState state) {
+    final files = _files[_draftKey] ?? [];
+    if (_input.text.trim().isEmpty && files.isEmpty) return;
+    try {
+      client.configure(mode: 'act');
+      client.sendMessage(_input.text, attachments: files);
+      _drafts[_draftKey] = '';
+      _input.clear();
+      _files[_draftKey] = [];
+      setState(() {});
+      _jumpToEnd();
+    } catch (e) {
+      _notice(e);
+    }
+  }
+
+  bool _followingFrame = false;
+  void _jumpToEnd({bool force = true}) {
+    if (force) _followOutput = true;
+    if (_followingFrame || !_followOutput) return;
+    _followingFrame = true;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      _followingFrame = false;
+      if (mounted &&
+          widget.active &&
+          _followOutput &&
+          _scroll.hasClients &&
+          _scroll.position.extentAfter > .5) {
+        _scroll.jumpTo(_scroll.position.maxScrollExtent);
+      }
+    });
+  }
