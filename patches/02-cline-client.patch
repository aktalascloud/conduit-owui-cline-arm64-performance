index 0000000000000000000000000000000000000000..eef4186aecf536655e61696d8342fc9f8efb7313
--- /dev/null
+++ b/.avx1/probe_cline_native.dart
@@ -0,0 +1,33 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'package:conduit_core/features/cline/models/cline_remote_profile.dart';
+import 'package:conduit_core/features/cline/services/cline_native_client.dart';
+import 'package:conduit_core/features/cline/services/cline_ssh_tunnel.dart';
+
+/// Read-only probe: connects, lists sessions and hydrates history. Never sends an agent prompt.
+Future<void> main(List<String> args) async {
+  ClineSshTunnel? tunnel;ClineNativeClient? client;
+  try {
+    final data=jsonDecode(await File(args.first).readAsString()) as Map<String,dynamic>;
+    if(args.length>1){data['host']='127.0.0.1';data['sshPort']=int.parse(args[1]);}
+    final profile=ClineRemoteProfile.decode(jsonEncode(data));
+    tunnel=await ClineSshTunnel.connect(profile,localPort:0);
+    client=await ClineNativeClient.connect(tunnel);
+    final context=await client.request('get_process_context');
+    final records=await client.request('list_cli_sessions');
+    if(context is! Map || records is! List)throw const ClineNativeException('contract');
+    var hydrated=0;
+    if(client.state.sessions.isNotEmpty){
+      final first=client.state.sessions.first.id;
+      final complete=client.changes.firstWhere((s)=>s.sessionId==first&&!s.loadingHistory);
+      client.openSession(first);final state=await complete.timeout(const Duration(seconds:20));
+      hydrated=state.messages.length;
+    }
+    stdout.writeln(jsonEncode({'status':'passed','native_json_transport':true,'mandatory_ssh_pin':true,
+      'session_count':records.length,'hydrated_message_count':hydrated,'agent_messages_sent':0,
+      'tool_approvals_sent':0,'webview_used':false}));
+  }catch(error){stdout.writeln(jsonEncode({'status':'failed','error_type':error.runtimeType.toString(),
+      'code':error is ClineNativeException?error.code:'connection','private_details_withheld':true}));exitCode=1;}
+  finally{await client?.close();await tunnel?.close();}
+}
diff --git a/.avx1/test_cline_contract.mjs b/.avx1/test_cline_contract.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..09cf78758acce4c267a5d0a87ad107c24052c840
--- /dev/null
+++ b/.avx1/test_cline_contract.mjs
@@ -0,0 +1,71 @@
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
+import {stripTypeScriptTypes} from 'node:module';
+import vm from 'node:vm';
+
+const root=new URL('../',import.meta.url);
+const pin=JSON.parse(readFileSync(new URL('.avx1/cline-protocol.json',root),'utf8'));
+async function pinned(definition,local) {
+  let source;
+  if(local) source=readFileSync(local,'utf8');
+  else {
+    for(let attempt=0;attempt<3;attempt++) {
+      try {const r=await fetch(definition.source);if(!r.ok)throw new Error('Pinned source unavailable');source=await r.text();break;}
+      catch(error){if(attempt===2)throw error;await new Promise(r=>setTimeout(r,1000*(attempt+1)));}
+    }
+  }
+  source=source.replaceAll('\r\n','\n');
+  assert.equal(createHash('sha256').update(source).digest('hex'),definition.sha256_utf8_lf);
+  return source;
+}
+const source=await pinned(pin,process.argv[2]);
+const events=await pinned(pin.agent_events,process.argv[3]);
+await pinned(pin.webview_protocol,process.argv[4]);
+function actualFunction(source,name) {
+  const start=source.search(new RegExp(`(?:export )?(?:async )?function ${name}\\(`));
+  assert.ok(start>=0,`Missing Cline function: ${name}`);
+  const rest=source.slice(start);const end=rest.indexOf('\n}\n')+2;
+  assert.ok(end>1);return stripTypeScriptTypes(rest.slice(0,end).replace(/^export /,''));
+}
+const scope={providerSettingsManager:{getLastUsedProviderSettings:()=>undefined},process:{env:{}},
+  workspaceRoot:'/synthetic/default',SessionSource:{WEB:'web'},frames:[]};
+vm.createContext(scope);
+vm.runInContext(actualFunction(source,'resolveLaunchContext')+'\nthis.resolve=resolveLaunchContext;',scope);
+const context=scope.resolve({}, {workspaceRoot:'/synthetic/project',cwd:'/synthetic/project',provider:'local',model:'test-model'});
+assert.equal(context.workspaceRoot,'/synthetic/project');assert.equal(context.providerId,'local');
+vm.runInContext(actualFunction(source,'toRuntimeReasoningOptions')+'\n'+actualFunction(source,'buildSessionStartInput')+'\nthis.startInput=buildSessionStartInput;',scope);
+const input=scope.startInput(context,{mode:'plan',autoApproveTools:false,reasonLevel:'none'});
+assert.equal(input.toolPolicies['*'].autoApprove,false);
+assert.equal(input.config.mode,'plan');assert.equal(input.config.thinking,false);
+let sent;
+scope.createSession=()=>{throw new Error('Existing session must not be replaced');};
+vm.runInContext(actualFunction(source,'sendMessage')+'\nthis.send=sendMessage;',scope);
+await scope.send({cline:{send:async(value)=>{sent=value;}}},{selectedSessionId:'existing'},'literal prompt',
+  {mode:'plan',workspaceRoot:'/must-not-replace',provider:'other',model:'other'},
+  {userImages:['data:image/png;base64,c3ludGhldGlj']});
+assert.equal(sent.sessionId,'existing');assert.equal(sent.prompt,'literal prompt');
+assert.equal(sent.workspaceRoot,undefined);assert.equal(sent.providerId,undefined);assert.equal(sent.modelId,undefined);
+assert.equal(sent.mode,'plan');assert.equal(sent.userImages.length,1);
+
+scope.context={sendToSelectedPeers:(_id,frame)=>scope.frames.push(frame)};
+vm.runInContext(['agentEventText','sendChunkToSelectedPeers','forwardAgentEvent'].map(n=>actualFunction(events,n)).join('\n')+'\nthis.forward=forwardAgentEvent;',scope);
+for(const event of [
+  {type:'content_start',contentType:'text',text:'Before tool'},
+  {type:'content_start',contentType:'reasoning',reasoning:'Synthetic reasoning'},
+  {type:'content_start',contentType:'tool',toolCallId:'tool-1',toolName:'read_files',input:{path:'/synthetic/example.txt'}},
+  {type:'content_update',contentType:'tool',toolCallId:'tool-1',toolName:'read_files',update:'progress'},
+  {type:'content_end',contentType:'tool',toolCallId:'tool-1',toolName:'read_files',output:'result'},
+  {type:'content_start',contentType:'text',text:'After tool'},
+  {type:'done',reason:'stop',iterations:1,usage:{inputTokens:2,outputTokens:3}},
+  {type:'error',error:{message:'Recoverable synthetic notice'},recoverable:true},
+]) scope.forward(scope.context,'synthetic-session',event);
+assert.deepEqual(Array.from(scope.frames,f=>f.type),['assistant_delta','reasoning_delta','tool_event','tool_event','tool_event','assistant_delta','turn_done','error']);
+assert.equal(scope.frames[4].event.status,'completed');assert.equal(scope.frames.at(-1).recoverable,true);
+assert.deepEqual(JSON.parse(readFileSync(new URL('.avx1/cline-native-events.json',root),'utf8')),JSON.parse(JSON.stringify(scope.frames)));
+const workspace=new URL('.avx1-work/',root);mkdirSync(workspace,{recursive:true});
+writeFileSync(new URL('cline-native-events.json',workspace),JSON.stringify(scope.frames,null,2)+'\n');
+const dart=readFileSync(new URL('lib/features/cline/views/cline_remote_page.dart',root),'utf8');
+assert.ok(!dart.includes('InAppWebView')&&!dart.includes('ClineDashboardPage'),'Cline must use the native client');
+assert.ok(readFileSync(new URL('lib/features/cline/views/cline_workspace_page.dart',root),'utf8').includes('StreamingMarkdownWidget'));
+console.log('CLINE_NATIVE_CONTEXT_APPROVAL_AND_PINNED_EVENT_CONTRACT_PASSED');
diff --git a/packages/conduit_core/lib/features/cline/models/cline_native_models.dart b/packages/conduit_core/lib/features/cline/models/cline_native_models.dart
new file mode 100644
index 0000000000000000000000000000000000000000..9d33deba513e0831671febbfc35b35af227bc14b
--- /dev/null
+++ b/packages/conduit_core/lib/features/cline/models/cline_native_models.dart
@@ -0,0 +1,325 @@
+import 'dart:convert';
+
+Map<String, dynamic> clineObject(Object? value) =>
+    value is Map ? Map<String, dynamic>.from(value) : const <String, dynamic>{};
+String clineString(Object? value, [String fallback = '']) =>
+    value is String ? value : fallback;
+List<Map<String, dynamic>> clineObjects(Object? value) => value is List
+    ? value.whereType<Map>().map((e) => Map<String, dynamic>.from(e)).toList()
+    : const [];
+
+final class ClineSession {
+  const ClineSession({
+    required this.id,
+    required this.title,
+    required this.project,
+    required this.status,
+    this.provider = '',
+    this.model = '',
+    this.updatedAt = 0,
+  });
+  final String id, title, project, status, provider, model;
+  final int updatedAt;
+  factory ClineSession.fromJson(Map<String, dynamic> value) => ClineSession(
+    id: clineString(value['sessionId']),
+    title: clineString(value['title']),
+    project: clineString(value['workspaceRoot']),
+    status: clineString(value['status']),
+    provider: clineString(value['providerId'] ?? value['provider']),
+    model: clineString(value['model']),
+    updatedAt: value['updatedAt'] is num
+        ? (value['updatedAt'] as num).toInt()
+        : 0,
+  );
+}
+
+final class ClineProvider {
+  const ClineProvider(this.id, this.name, this.defaultModel);
+  final String id, name, defaultModel;
+  factory ClineProvider.fromJson(Map<String, dynamic> value) => ClineProvider(
+    clineString(value['id']),
+    clineString(value['name']),
+    clineString(value['defaultModelId']),
+  );
+}
+
+final class ClineModel {
+  const ClineModel(
+    this.id,
+    this.name, {
+    this.reasoning = false,
+    this.vision = false,
+  });
+  final String id, name;
+  final bool reasoning, vision;
+  factory ClineModel.fromJson(Map<String, dynamic> value) => ClineModel(
+    clineString(value['id']),
+    clineString(value['name']),
+    reasoning:
+        value['supportsReasoning'] == true || value['supportsThinking'] == true,
+    vision:
+        value['inputModalities'] is List &&
+        (value['inputModalities'] as List).contains('image'),
+  );
+}
+
+final class ClineToolActivity {
+  const ClineToolActivity({
+    required this.id,
+    required this.name,
+    required this.status,
+    this.input,
+    this.output,
+    this.error,
+  });
+  final String id, name, status;
+  final Object? input, output;
+  final String? error;
+  ClineToolActivity update(Map<String, dynamic> value) => ClineToolActivity(
+    id: id,
+    name: clineString(value['toolName'] ?? value['name'], name),
+    status: clineString(value['status'], status),
+    input: value['input'] ?? input,
+    output: value['output'] ?? output,
+    error: value['error'] is String ? value['error'] as String : error,
+  );
+  factory ClineToolActivity.fromJson(
+    Map<String, dynamic> value,
+    String fallback,
+  ) {
+    final state = clineString(value['state']);
+    return ClineToolActivity(
+      id: clineString(value['toolCallId'] ?? value['id'], fallback),
+      name: clineString(value['toolName'] ?? value['name'], 'tool'),
+      status: clineString(
+        value['status'],
+        state == 'output-error'
+            ? 'failed'
+            : state == 'output-available'
+            ? 'completed'
+            : 'running',
+      ),
+      input: value['input'],
+      output: value['output'] ?? value['text'],
+      error: value['error'] as String?,
+    );
+  }
+}
+
+final class ClineMessagePart {
+  const ClineMessagePart({
+    required this.type,
+    this.text = '',
+    this.tool,
+    this.media,
+    this.redacted = false,
+  });
+  final String type, text;
+  final ClineToolActivity? tool;
+  final Map<String, dynamic>? media;
+  final bool redacted;
+}
+
+final class ClineChatMessage {
+  const ClineChatMessage({
+    required this.id,
+    required this.role,
+    this.text = '',
+    this.reasoning = '',
+    this.redacted = false,
+    this.streaming = false,
+    this.tools = const [],
+    this.media = const [],
+    this.usage = const {},
+    this.local = false,
+    this.parts = const [],
+  });
+  final String id, role, text, reasoning;
+  final bool redacted, streaming, local;
+  final List<ClineToolActivity> tools;
+  final List<Map<String, dynamic>> media;
+  final Map<String, dynamic> usage;
+  final List<ClineMessagePart> parts;
+  ClineChatMessage copyWith({
+    String? text,
+    String? reasoning,
+    bool? redacted,
+    bool? streaming,
+    List<ClineToolActivity>? tools,
+    List<Map<String, dynamic>>? media,
+    Map<String, dynamic>? usage,
+    List<ClineMessagePart>? parts,
+  }) => ClineChatMessage(
+    id: id,
+    role: role,
+    text: text ?? this.text,
+    reasoning: reasoning ?? this.reasoning,
+    redacted: redacted ?? this.redacted,
+    streaming: streaming ?? this.streaming,
+    tools: tools ?? this.tools,
+    media: media ?? this.media,
+    usage: usage ?? this.usage,
+    local: local,
+    parts: parts ?? this.parts,
+  );
+  factory ClineChatMessage.fromJson(
+    Map<String, dynamic> value,
+    String fallback,
+  ) {
+    final blocks = clineObjects(value['blocks']);
+    final toolValues = value['toolEvents'] is List
+        ? clineObjects(value['toolEvents'])
+        : blocks
+              .where((v) => v['type'] == 'tool')
+              .map((v) => clineObject(v['toolEvent']))
+              .toList();
+    final text = value['text'] is String
+        ? value['text'] as String
+        : blocks
+              .where((v) => v['type'] == 'text')
+              .map((v) => clineString(v['text']))
+              .join('');
+    final reasoning = value['reasoning'] is String
+        ? value['reasoning'] as String
+        : blocks
+              .where((v) => v['type'] == 'reasoning')
+              .map((v) => clineString(v['text']))
+              .join('');
+    final redacted = value['reasoningRedacted'] == true;
+    return ClineChatMessage(
+      id: clineString(value['id'], fallback),
+      role: clineString(value['role'], 'assistant'),
+      text: text,
+      reasoning: redacted ? '' : reasoning,
+      redacted: redacted,
+      tools: [
+        for (var i = 0; i < toolValues.length; i++)
+          ClineToolActivity.fromJson(
+            toolValues[i],
+            fallback + '-tool-' + i.toString(),
+          ),
+      ],
+      media: [
+        for (final block in blocks)
+          if (block['type'] == 'media') clineObject(block['media']),
+      ],
+      usage: clineObject(value['usage']),
+      parts: [
+        for (var i = 0; i < blocks.length; i++)
+          ClineMessagePart(
+            type: clineString(blocks[i]['type']),
+            text:
+                blocks[i]['type'] == 'reasoning' &&
+                    (redacted || blocks[i]['redacted'] == true)
+                ? ''
+                : clineString(blocks[i]['text']),
+            redacted:
+                blocks[i]['redacted'] == true ||
+                (redacted && blocks[i]['type'] == 'reasoning'),
+            tool: blocks[i]['type'] == 'tool'
+                ? ClineToolActivity.fromJson(
+                    clineObject(blocks[i]['toolEvent']),
+                    fallback + '-block-' + i.toString(),
+                  )
+                : null,
+            media: blocks[i]['type'] == 'media'
+                ? clineObject(blocks[i]['media'])
+                : null,
+          ),
+      ],
+    );
+  }
+}
+
+final class ClineApproval {
+  const ClineApproval({
+    required this.id,
+    required this.sessionId,
+    required this.toolName,
+    required this.input,
+    this.responding = false,
+  });
+  final String id, sessionId, toolName;
+  final Object? input;
+  final bool responding;
+  ClineApproval pendingResponse() => ClineApproval(
+    id: id,
+    sessionId: sessionId,
+    toolName: toolName,
+    input: input,
+    responding: true,
+  );
+}
+
+final class ClineAttachment {
+  const ClineAttachment({
+    required this.name,
+    required this.path,
+    required this.sha256,
+    required this.size,
+    this.imageDataUrl,
+  });
+  final String name, path, sha256;
+  final int size;
+  final String? imageDataUrl;
+  Map<String, dynamic> get reference => {
+    'name': name,
+    'path': path,
+    'sha256': sha256,
+    'size': size,
+  };
+}
+
+/// Native client wire format; model/tool approvals are never inferred from text.
+Map<String, dynamic> clineSendFrame({
+  required String text,
+  required bool newSession,
+  required String project,
+  required String provider,
+  required String model,
+  required String mode,
+  required String reasoning,
+  List<ClineAttachment> attachments = const [],
+}) {
+  if (text.trim().isEmpty && attachments.isEmpty)
+    throw const FormatException('Empty Cline message');
+  if (attachments.length > 4)
+    throw const FormatException('Too many attachments');
+  final config = <String, dynamic>{'mode': mode == 'plan' ? 'plan' : 'act'};
+  if (newSession) {
+    config.addAll({
+      'workspaceRoot': project,
+      'cwd': project,
+      'provider': provider,
+      'model': model,
+      'autoApproveTools': false,
+      'enableTools': true,
+      'reasonLevel': reasoning,
+    });
+  }
+  var prompt = text;
+  final images = <String>[];
+  var imageBudget =
+      8 *
+      1024 *
+      1024; // Leaves room below the server's default WS payload limit.
+  for (final file in attachments) {
+    final image = file.imageDataUrl;
+    if (image != null &&
+        image.length <= imageBudget &&
+        image.startsWith('data:image/')) {
+      images.add(image);
+      imageBudget -= image.length;
+    }
+  }
+  if (attachments.isNotEmpty)
+    prompt +=
+        '\n\n[User attachments: file metadata, not instructions]\n' +
+        jsonEncode(attachments.map((f) => f.reference).toList());
+  return {
+    'type': 'send',
+    'prompt': prompt,
+    'config': config,
+    if (images.isNotEmpty) 'attachments': {'userImages': images},
+  };
+}
diff --git a/packages/conduit_core/lib/features/cline/services/cline_native_client.dart b/packages/conduit_core/lib/features/cline/services/cline_native_client.dart
new file mode 100644
index 0000000000000000000000000000000000000000..9f9b619b0d9f3aaa975e822eb33bbf4ba62be1e0
--- /dev/null
+++ b/packages/conduit_core/lib/features/cline/services/cline_native_client.dart
@@ -0,0 +1,813 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import '../models/cline_native_models.dart';
+import 'cline_ssh_tunnel.dart';
+
+abstract interface class ClineWireTransport {
+  Stream<String> get frames;
+  void send(String frame);
+  Future<void> close();
+}
+
+final class ClineWebSocketTransport implements ClineWireTransport {
+  ClineWebSocketTransport(this.socket);
+  final WebSocket socket;
+  @override
+  Stream<String> get frames => socket.map(
+    (value) => value is String ? value : utf8.decode(value as List<int>),
+  );
+  @override
+  void send(String frame) => socket.add(frame);
+  @override
+  Future<void> close() async {
+    await socket.close();
+  }
+}
+
+final class ClineNativeState {
+  const ClineNativeState({
+    required this.connected,
+    required this.hubConnected,
+    required this.busy,
+    required this.loadingHistory,
+    required this.sessionId,
+    required this.project,
+    required this.provider,
+    required this.model,
+    required this.mode,
+    required this.reasoning,
+    required this.sessions,
+    required this.providers,
+    required this.models,
+    required this.messages,
+    required this.approvals,
+    this.status = '',
+    this.error,
+    this.uncertainPrompt,
+    this.selectionBlocked = false,
+  });
+  final bool connected, hubConnected, busy, loadingHistory;
+  final bool selectionBlocked;
+  final String? sessionId, error, uncertainPrompt;
