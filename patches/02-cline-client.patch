+              _pendingPrompt != null ||
+              {'running', 'starting', 'stopping'}.contains(frame['status']);
+          _assistantId = null;
+        case 'assistant_delta':
+          _appendText('text', clineString(frame['text']));
+        case 'reasoning_delta':
