+          _sessionId = id;
+          _awaitedSession = null;
+          _loadingHistory = false;
+          final values = clineObjects(frame['messages']);
+          final optimistic = _messages
+              .where((m) => m.local && m.role == 'user')
+              .toList();
+          _messages = [
+            for (var i = 0; i < values.length; i++)
