+    if (request == null ||
+        request.responding ||
+        request.sessionId != _sessionId)
+      throw const ClineNativeException('approval');
+    _approvals[id] = request.pendingResponse();
+    _send({
+      'type': 'approval_response',
+      'approvalId': id,
+      'approved': approved,
+    });
+    _notify(immediate: true);
+  }
+
+  void abort() {
+    if (_busy) _send({'type': 'abort'});
+  }
+
+  void clearError() {
+    _error = null;
+    _notify(immediate: true);
+  }
