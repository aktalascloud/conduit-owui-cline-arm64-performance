+  List<ClineSession> _sessions = [];
+  List<ClineProvider> _providers = [];
+  final Map<String, List<ClineModel>> _models = {};
+  List<ClineChatMessage> _messages = [];
+  final Map<String, ClineApproval> _approvals = {};
