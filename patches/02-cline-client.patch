+  Future<void>? _ownerClosed;
+  final _ready = Completer<void>();
+  final Map<String, Completer<Object?>> _requests = {};
+  Timer? _notification;
+  bool _connected = true,
+      _hubConnected = false,
+      _busy = false,
+      _loadingHistory = false,
+      _closed = false;
+  bool _newTurn = false, _resetting = false, _selectingModel = false;
+  bool _selectionBlocked = false;
+  String? _sessionId,
+      _awaitedSession,
+      _assistantId,
+      _error,
+      _pendingPrompt,
+      _uncertainPrompt;
+  String _project,
