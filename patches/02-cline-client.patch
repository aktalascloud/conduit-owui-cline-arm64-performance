+    if (project != null) _project = project;
+    if (mode != null) _mode = mode == 'plan' ? 'plan' : 'act';
+    if (reasoning != null &&
+        {'none', 'low', 'medium', 'high'}.contains(reasoning))
+      _reasoning = reasoning;
+    if (_selectionAvailable) {
